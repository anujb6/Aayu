{
  "configVersion": "v3",
  "app": {
    "appId": 22931,
    "appName": "Aayu",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Aayu",
    "description": "A fitness-driven virtual pet that evolves based on your activity"
  },
  "permissions": [
    "device:os.local_storage",
    "data:user.hd.heart_rate",
    "data:user.hd.step",
    "data:user.hd.distance",
    "data:user.hd.calorie",
    "data:user.hd.pai"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/home/index",
            "page/stats/index",
            "page/evolution/index",
            "page/traits/index",
            "page/collection/index"
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Aayu"
    }
  },
  "defaultLanguage": "en-US"
}
